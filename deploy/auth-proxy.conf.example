# Standalone nginx alternative; direct Cloudflare Tunnel does not need nginx.
# Behind cloudflared, $remote_addr is the connector, not the visitor. Configure
# trusted real-client-IP handling before using this example in that topology.
# Include this file in nginx's http context. Supply the owned-domain certificate
# configuration. server_name must match the BETTER_AUTH_URL hostname.
# Node remains loopback-only: SAVVY_AUTH_TRUSTED_PROXIES=127.0.0.1
map $http_upgrade $savvy_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name api.savvycopilot.com;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 64k;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Savvy-Proxy-IP $remote_addr;
    proxy_set_header X-Savvy-Client-IP "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Forwarded "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $savvy_connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout 130s;
    proxy_send_timeout 130s;
    proxy_buffering off;
    proxy_cache off;

    location /v1/ {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:8788;
    }
    location / {
        proxy_pass http://127.0.0.1:8788;
    }
}
