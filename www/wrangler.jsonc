{
  "name": "savvy-www",
  "compatibility_date": "2026-08-28",
  "main": "./worker.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.savvycopilot.com", "custom_domain": true },
    { "pattern": "savvycopilot.com", "custom_domain": true }
  ]
}
