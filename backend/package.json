{
  "name": "savvy-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "migrate": "node build/migrate.js",
    "backup": "node build/backup.js",
    "typecheck": "tsc --noEmit",
    "build": "pnpm build:server && pnpm build:ui",
    "test": "tsx --test src/*.test.ts",
    "test:browser": "pnpm build && tsx --test src/browser.check.ts src/team.check.ts",
    "test:desktop": "tsx --test src/desktop.check.ts",
    "test:connected-e2e": "node --env-file=scripts/connected-e2e.flags --import tsx --test --test-name-pattern=\"connected CRM and document\" src/ai.test.ts",
    "test:connected-live": "tsx src/composio.live.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:ui": "vite build",
    "test:native-auth": "pnpm build && cargo test -p savvy --lib local_stripe_sandbox_desktop_transport --locked --no-run && node --env-file=scripts/native-auth.flags --import tsx --test src/browser.check.ts",
    "test:load": "pnpm build:server && node --test e2e/load.test.mjs",
    "test:package": "pnpm build && node --test e2e/package.test.mjs",
    "test:web-return": "pnpm --dir ../www build && tsx --test src/return.check.ts",
    "capability": "node build/capability.js",
    "rollback-preflight": "node build/rollback-preflight.js"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.14",
    "@composio/core": "0.27.0",
    "better-auth": "1.7.14",
    "better-call": "2.0.6",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.13",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "1.63.0",
    "playwright": "1.64.1",
    "smtp-server": "3.21.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@10.34.5"
}
