# One backend listener. Retain the existing auth issuer and signing secret.
BETTER_AUTH_URL=http://127.0.0.1:8788
BETTER_AUTH_SECRET=
SAVVY_HOST=127.0.0.1
PORT=8788
# Separate files in the same service. For migration, use copies of existing files.
SAVVY_AUTH_DATABASE=./savvy-auth.sqlite
SAVVY_DB_PATH=./savvy-service.sqlite
SAVVY_OIDC_CLIENT_ID=savvy-desktop
# Preserve this resource audience even when the service URL changes.
SAVVY_OIDC_AUDIENCE=https://api.savvy.alamaslabs.com

# Register /api/auth/callback/google on BETTER_AUTH_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Savvy <auth@example.test>"
SMTP_USER=
SMTP_PASSWORD=
# Exact proxy peers permitted to set X-Savvy-Proxy-IP; empty trusts nobody.
SAVVY_AUTH_TRUSTED_PROXIES=

SAVVY_ANTHROPIC_API_KEY=
SAVVY_AI_MODEL=claude-sonnet-5
SAVVY_ANTHROPIC_BASE_URL=https://api.anthropic.com
SAVVY_DEEPGRAM_API_KEY=
SAVVY_DEEPGRAM_URL=wss://api.deepgram.com/v1/listen
SAVVY_STRIPE_SECRET_KEY=
SAVVY_STRIPE_WEBHOOK_SECRET=
SAVVY_STRIPE_PRICE_MONTHLY=
SAVVY_STRIPE_PRICE_PACK=
SAVVY_STRIPE_BASE_URL=https://api.stripe.com
SAVVY_CHECKOUT_RETURN_URL=http://127.0.0.1:3000/checkout-complete/
# Never enable development grants outside isolated local fixtures.
# SAVVY_DEV_FIXTURES=1 also requires every upstream URL to be loopback.
