{
  "name": "savvy",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamalavedra/savvy.git"
  },
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace --locked",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:rust && pnpm --dir backend typecheck && pnpm --dir backend test",
    "verify": "pnpm format:check && pnpm check && pnpm build && cargo clippy --workspace --all-targets --locked -- -D warnings && pnpm --dir backend build",
    "preview": "vite preview",
    "desktop:install": "./scripts/build-install-run-macos.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tauri-plugin-macos-permissions-api": "2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "source-map-js": "1.2.2",
      "zod": "^4.6.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-g3hv-75wg-m249"
      ]
    }
  },
  "volta": {
    "node": "22.23.4",
    "pnpm": "10.34.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
